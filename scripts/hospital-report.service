[Unit]
Description=Wandikweza Hospital Monthly Report Generator
After=network.target mysql.service

[Service]
Type=oneshot
User=ghii
WorkingDirectory=/home/ghii/DevelopmentApps/Billing/scripts
ExecStart=/usr/bin/python3 /home/ghii/DevelopmentApps/Billing/scripts/generate_report.py --auto
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
