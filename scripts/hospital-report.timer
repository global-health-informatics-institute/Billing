[Unit]
Description=Run Wandikweza Hospital Report at 8:30 AM
Requires=hospital-report.service

[Timer]
# Run tomorrow at 8:30 AM for testing
OnCalendar=2026-05-21 08:30:00
# For production: Run on the 1st of every month at 8:30 AM
# OnCalendar=*-*-01 08:30:00
Persistent=true

[Install]
WantedBy=timers.target
