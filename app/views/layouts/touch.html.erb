<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
    "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
  <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
  <% @title = "#{controller.controller_name.humanize} #{controller.action_name.humanize}" rescue ""  %>
  <script type="text/javascript" language="javascript" src="/assets/touchScreenToolkit.js" defer="true"></script>
  <script type="text/javascript" language="javascript" src="/assets/jquery-1.12.0.min.js" ></script>
  <script language="javascript">
       tstUserKeyboardPref = "<%=preferred_user_keyboard%>"
       tstUsername = "<%= current_user.username unless current_user.nil? %>";
      // tstCurrentDate = "<%#= Time.now.strftime("%Y-%m-%d") %>";
  </script>
</head>
<body id="container">
<div id="content">
  <div id="description" style="color:#777;position:absolute;margin-top:-70px;">
    <% if show_intro_text %>
        This demonstration site contains the work of <a href="http://pih.org" style="color:white">Partners In Health</a>
        and <a href="http://baobabhealth.org" style="color:white">Baobab Health.</a>
        This EMR is built on top of OpenMRS 1.4 and is currently being used in Neno and Ngoni, Malawi.
        It is designed for an 800 by 600 pixel touch screen at the point of patient contact.
        <br/><a href="mailto:jeff@baobabhealth.org" style="color:white">Email</a> with questions.
        Login using the sample login "demo", password "demo" and location "7".
    <% end %>
  </div>
  <% unless flash[:notice].nil? %>
      <p id="flash_notice" style="color: green; font-size: 1.5em; font-weight: bold;"><%= flash[:notice] %></p>
  <% end %>
  <% unless flash[:error].nil? %>
      <p id="flash_error" style="color: red; font-size: 1.5em; font-weight: bold;"><%= flash[:error] %></p>
  <% end %>
  <% unless flash[:error].nil? %>
      <p id="flash_alert" style="color: green; font-size: 1.5em; font-weight: bold;"><%= flash[:alert] %></p>
  <% end %>
  <%= yield %>
  <div id="flash-snackbar" style="display:none; position:fixed; top:20px; left:50%; transform:translateX(-50%); background:#333; color:#fff; padding:20px 30px; font-size:1.5em; border-radius:4px; z-index:10000;"></div>
  <script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
      var msg = "<%= j(flash[:success] || flash[:error] || flash[:errors] || '') %>";
      if (msg && msg.length > 0) {
        var el = document.getElementById('flash-snackbar');
        el.textContent = msg;
        el.style.display = 'block';
        if (("<%= j flash[:success].present? %>") === 'true') el.style.background = '#2ecc71';
        else el.style.background = '#e74c3c';
        setTimeout(function(){ el.style.display = 'none'; }, 5000);
      }
    });
  </script>
  <div id="footer">
  </div>
</div>
</div>
</body>
</html>
