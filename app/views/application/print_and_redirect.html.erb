<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Printing...</title>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; padding-top: 30px; }
    .message { font-size: 18px; margin-bottom: 20px; }
  </style>
</head>
<body>
  <div class="message"><%= @message %></div>
  <script>
    (function(){
      try {
        // Open print URL in a new window/tab so printing can proceed
        var printWindow = window.open("<%= @print_url %>", "_blank");
      } catch(e) {
        console.error(e);
      }

      // After a short delay redirect back to the app
      setTimeout(function(){
        var redirectUrl = "<%= @redirect_url %>";
        if (redirectUrl === "__HISTORY_BACK__") {
          window.history.go(-2);
        } else {
          window.location = redirectUrl;
        }
      }, 1200);
    })();
  </script>
</body>
</html>
