    <style>
        body {
            font-family: 'Arial', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 80vh;
            background: #f0f0f0;
            margin: 0;
            overflow-y: auto;
        }
        .receipt {
            background: white;
            padding: 20px;
            border-radius: 10px;
            width: 80vw;
            text-align: center;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            border-top: 5px solid #000;
        }
        h2 {
            margin: 5px 0;
            color: #555555;
        }
        .info {
            text-align: left;
            font-size: 14px;
            margin-bottom: 15px;
            padding: 10px;
            background: #f9f9f9;
            border-radius: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
            margin-top: 10px;
        }
        th, td {
            border-bottom: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background: #f1f1f1;
            color: #000;
            text-transform: uppercase;
        }
        .total {
            font-weight: bold;
            background: #f1f1f1;
        }
        .print-btn {
            background: #28a745;
            color: white;
            padding: 10px 20px;
            margin-top: 15px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            border-radius: 5px;
        }
        .thank-you {
            margin-top: 10px;
            font-size: 12px;
            font-style: bold
;
            color: #555;
        }
    </style>
</head>
    <div class="receipt">
        <h2> <%= facility_name.titleize %></h2>
        <p>Cashier Summary Receipt</p>
        <div class="info">
            <p><strong>Date:</strong> <%= Time.now.strftime("%A, %B %d, %Y, %I:%M %p") %> </p>
            <p>
              <strong>Description:</strong> 
              <%= @title %>
            </p>
        </div>
        <table>
          <tr>
              <th>Service Name</th>
              <th>Amount (MWK)</th>
              <th>Received (MWK)</th>
          </tr>
          <% @service_totals.each do |key, value| %>
              <% if key.to_s.end_with?('_price') %>
                  <% service_name = key.to_s.gsub('_price', '').gsub('_', ' ').titleize %>
                  <% paid_key = "#{key.to_s.gsub('_price', '_paid')}".to_sym %>
                  <tr>
                    <td><%= service_name %></td>
                    <td><%= number_with_precision(value, precision: 2) %></td>
                    <td><%= number_with_precision(@service_totals[paid_key], precision: 2) %></td>
                  </tr>
              <% end %>
            <% end %>
            <tr class="total">
                <td>Voided</td>
                <td><%= number_with_precision(@totals[:total_voided_price], precision: 2) %></td>
                <td><%= number_with_precision(@totals[:total_voided_paid], precision: 2) %></td>
            </tr>
          <tr class="total">
              <td>Total</td>
              <td><%= number_with_precision(@totals[:total_full_price], precision: 2) %></td>
              <td><%= number_with_precision(@totals[:total_amount_paid], precision: 2) %></td>
          </tr>
          <hr>
          <tr class="total">
              <td><b>Total refunds:</b> <%=local_currency(@totals[:total_refund])%></td>
              <td></td>
              <td></td>
          </tr>
      </table>
        <p class="thank-you">Billing v2.0. - Wandimweza Hospital</p>
    </div>
<div class="footer">
  <button class="green" style="float: right;" onmousedown="window.location='/'">Finish</button>
  <button style="float: right;" onmousedown="window.location='/main/print_daily_cash_summary?start_date=<%= @start_date %>&end_date=<%= @end_date %>&shift=<%= @shift%>'">Print</button>

</div>
