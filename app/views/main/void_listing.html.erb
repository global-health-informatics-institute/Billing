<style>
    body {
        font-family: 'Arial', sans-serif;
        display: flex;
        justify-content: center;
        align-items: start;
        background: #ffffff;
        margin: 0;
        font-size: 22px;
    }
    .receipt {
        background: #ffffff;
        padding: 20px;
        width: 100vw;
        height: 100%;
        text-align: center;
        overflow-y: auto;
    }
    h2 {
        margin: 5px 0;
        color: #555555;
    }
    .info {
        text-align: left;
        margin-bottom: 15px;
        padding: 10px;
        background: #cccccc;
        border-radius: 5px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }
    th, td {
        border-bottom: 1px solid #ddd;
        padding: 8px;
        text-align: left;
    }
    th {
        background: #555555;
        color: #fff;
        text-transform: uppercase;
    }
    .total {
        font-weight: bold;
        background: #f1f1f1;
    }
    .print-btn {
        background: #28a745;
        color: white;
        padding: 10px 20px;
        margin-top: 15px;
        border: none;
        cursor: pointer;
        border-radius: 5px;
    }
    .thank-you {
        margin-top: 10px;
        font-size: 20px;
        font-style: bold;
        color: #555;
    }
    table tbody tr:nth-child(even) {
        background-color: #f1f1f1;
    }

    table tbody tr:nth-child(odd) {
        background-color: #fff;
    }

</style>
</head>
    <div class="receipt">
        <h2> <%= facility_name.titleize %></h2>
        <p>Cashier Void Listing - <%= Time.now.strftime("%A, %B %d, %Y, %I:%M %p") %> </p>
        <div class="info">
            <p><strong>Date:</strong> <%= @duration %> </p>
            <p>
              <strong>Name:</strong> 
              <%= @user.name %>
            </p>
            <p>
                <strong>
                    Voided Receipts:
                </strong>
                <%= @void_list[:receipt_count] %>
            </p>
        </div>
        <table>
            <thead>
                <tr>
                <th>Receipt Number</th>
                <th>Amount Billed</th>
                <th>Amount Paid</th>
                <% if @type == 'Daily' %>
                    <th>Issue Time</th>
                <% else %>
                    <th>Issue Date</th>
                <% end %>
                <% if @type == 'Daily' %>
                    <th>Voided Time</th>
                <% else %>
                    <th>Voided Date</th>
                <% end %>
                <th>Void Reason</th>
                </tr>
            </thead>
            <tbody>
                <% @void_list[:records].each do |record| %>
                <tr>
                    <td><%= record[:receipt_number] %></td>
                    <td><%= local_currency(record[:amount_billed]) %></td>
                    <td><%= local_currency(record[:amount_paid]) %></td>
                    <% if @type == 'Daily' %>
                    <!-- Extract time only -->
                    <td><%= record[:issued_time].strftime("%I:%M %p") %></td>
                    <td><%= record[:voided_time].strftime("%I:%M %p") %></td>
                    <% else %>
                    <!-- More detailed date & time -->
                    <td><%= record[:issued_time].strftime("%B %d, %Y %I:%M %p") %></td>
                    <td><%= record[:voided_time].strftime("%B %d, %Y %I:%M %p") %></td>
                    <% end %>
                    <td><%= record[:voided_reason].present? ? record[:voided_reason] : "N/A" %></td>
                </tr>
                <% end %>
            </tbody>
            </table>

        <p class="thank-you">Billing v2.0. - Wandimweza Hospital</p>
    </div>
<div class="footer">
  <button class="green" style="float: right;" onmousedown="window.location='/'">Finish</button>
</div>
<% puts"THE VOID LISYING #{@void_list}"%>
