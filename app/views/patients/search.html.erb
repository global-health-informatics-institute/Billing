<% title "Patient Search" %>
<style type="text/css">
  html, body {
    margin: 0;
    padding: 0;
    background: #d7d7d9;
    font-family: "Century Gothic", "Trebuchet MS", Arial, sans-serif;
  }

  .search-shell {
    border: 1px solid #2c2c2c;
    background: #d0d0d2;
    min-height: 100vh;
    box-sizing: border-box;
  }

  #header {
    font-size: 16px;
    height: 15vh;
    width: 98vw;
    margin-top: 1vh;
    margin-left: auto;
    margin-right: auto;
  }

  #header .header-cell {
    border: 1.5px solid var(--ui-color-border);
    box-shadow: none;
    background: #f5f5f6;
  }

  .confirm-top {
    display: grid;
    grid-template-columns: 1fr 15vw;
    gap: 8px;
    height: 15vh;
  }

  .confirm-top-main {
    border: 2px solid var(--ui-color-border);
    background: #efeff0;
    padding: 10px 14px;
  }

  .confirm-top-title {
    font-size: 1.45em;
    color: #1c2869;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.2;
  }

  .confirm-scan-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: center;
    margin-bottom: 8px;
  }

  .confirm-scan-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.1em;
    font-weight: 700;
    color: #0f1524;
  }

  .confirm-scan-input {
    width: 100%;
    max-width: 520px;
    font-size: 1.1em;
    padding: 6px 8px;
    border: 1.5px solid #9fa6b2;
    background: #fff;
    color: #0f1524;
    box-sizing: border-box;
  }

  .confirm-meta {
    font-size: 1.08em;
    color: #22324a;
    line-height: 1.6;
    display: grid;
    grid-template-columns: 95px 1fr 95px 1fr;
    column-gap: 12px;
    row-gap: 3px;
  }

  .confirm-meta > div:nth-child(odd) {
    font-weight: 700;
    color: #2b3d5e;
  }

  .confirm-meta > div:nth-child(even) {
    font-weight: 600;
    color: #101828;
  }

  #header .confirm-brand strong {
    margin: 0;
    font-size: 1.5em;
    color: #0f1524;
  }

  #header .confirm-brand span {
    margin: 6px 0 0;
    font-size: 1.05em;
    color: #2f3f58;
  }

  .search-top {
    border-bottom: 1px solid #2378f8;
    padding: 6px;
  }
  .confirm-brand {
    border: 2px solid var(--ui-color-border);
    background: #f5f5f6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #0f1524;
    text-align: center;
  }

  .search-top-grid {
    display: grid;
    grid-template-columns: 1fr 145px;
    gap: 6px;
  }

  .search-top-main {
    border: 3px solid #2378f8;
    background: #fff;
    padding: 5px 8px 6px;
    font-size: 12px;
    color: #0f1524;
    min-height: 90px;
    box-sizing: border-box;
  }

  .search-top-head {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 5px;
  }

  .search-top-icon {
    color: #2b2ca8;
    font-size: 14px;
    line-height: 1;
    margin-top: -2px;
  }

  .search-top-bars {
    color: #2b2b2b;
    font-size: 12px;
    letter-spacing: -1px;
    line-height: 1;
    margin-left: 1px;
    margin-right: 6px;
  }

  .search-top-scan-input {
    flex: 1;
    border: 0;
    border-bottom: 1px solid #2f2f2f;
    background: transparent;
    height: 28px;
    margin-top: 14px;
    outline: none;
    font-size: 26px;
    line-height: 1.2;
    color: #111;
  }

  .search-top-title {
    color: #000;
    font-weight: 700;
    font-size: 31px;
    line-height: 1.1;
    margin-right: 1px;
  }

  .search-top-main table {
    width: 100%;
    font-size: 12px;
    color: #121826;
    border-collapse: collapse;
    line-height: 1.2;
    font-family: "Trebuchet MS", Arial, sans-serif;
    table-layout: fixed;
  }

  .search-top-main td {
    padding: 4px 0 0;
    vertical-align: middle;
  }

  .search-top-main td:first-child {
    color: #2e3a67;
    width: 76px;
    font-size: 20px;
  }

  .search-top-main .search-left-value {
    color: #070b15;
    font-size: 26px;
    font-weight: 700;
    width: 40%;
    padding-left: 14px !important;
  }

  .search-top-main td strong {
    color: #070b15;
    font-weight: 700;
    font-size: 24px;
  }

  .search-top-main .search-meta-key {
    color: #55608a;
    font-size: 20px;
    padding-right: 8px;
    width: 52px;
  }

  .search-top-main .search-meta-value {
    color: #070b15;
    font-size: 18px;
    font-weight: 700;
  }

  .search-top-main td:nth-child(2),
  .search-top-main td:nth-child(4) {
    padding-left: 3px;
  }

  .search-brand {
    border: 3px solid #2378f8;
    background: #ececed;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.35;
  }

  .search-brand strong {
    font-size: 33px;
    font-weight: 700;
  }

  .search-brand span {
    font-size: 18px;
  }

  .search-body {
    padding: 10px 12px 96px;
    margin-top: 3vh;
    width: 98vw;
    margin-left: auto;
    margin-right: auto;
    height: 70vh;
    box-sizing: border-box;
  }

  .search-tabs {
    display: flex;
    gap: 3px;
    margin-bottom: 0;
    justify-content: center;
  }

  .search-tab {
    border: 1px solid #9097a6;
    border-bottom: 0;
    background: #cfd2d6;
    padding: 8px 16px;
    border-radius: 8px 8px 0 0;
    color: #2d3340;
    font-weight: 700;
    font-size: 16px;
  }

  .search-tab.active {
    background: #e7e7e9;
    color: #111;
  }

  .search-panel {
    border: 1px solid #9aa0ad;
    background: #ececed;
    padding: 18px;
    min-height: calc(74vh - 70px);
    position: relative;
  }

  .search-panel h2 {
    margin: 0 0 10px;
    font-size: 40px;
    font-weight: 400;
    color: #111;
  }

  .scan-zone {
    background: #000;
    min-height: 210px;
    color: #4f6989;
    font-family: monospace;
    font-size: 35px;
    padding: 60px 20px 20px;
    box-sizing: border-box;
  }

  .scan-status {
    display: inline-block;
    animation: scanPulse 1.8s ease-in-out infinite;
  }

  @keyframes scanPulse {
    0% { opacity: 0.45; }
    50% { opacity: 1; }
    100% { opacity: 0.45; }
  }

  .scan-note {
    margin-top: 14px;
    font-size: 18px;
    color: #2f3f58;
  }

  .search-info-dot {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    border: 1px solid #4650a7;
    background: #4f58b1;
    color: #fff;
    text-align: center;
    line-height: 23px;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
  }

  .search-actions {
    background: linear-gradient(#343438, #202024);
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    border-top: 1px solid #3f4046;
    margin-top: 14px;
  }

  .search-actions-right {
    display: flex;
    gap: 8px;
  }

  .action-btn {
    border: 1px solid #243071;
    border-radius: 4px;
    color: #fff;
    font-weight: 700;
    padding: 8px 18px;
    font-size: 16px;
    background: linear-gradient(#5e78d1, #30489c);
    cursor: pointer;
  }

  .action-btn.cancel {
    border-color: #6f0808;
    background: linear-gradient(#df2642, #ad0018);
  }

  .action-btn.disabled {
    border-color: #888;
    background: linear-gradient(#b9b9b9, #929292);
    color: #e9e9e9;
    cursor: not-allowed;
  }

  .search-help-pop {
    display: none;
    position: absolute;
    right: 14px;
    top: 44px;
    width: 320px;
    background: #fff;
    border: 1px solid #838aa2;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.4;
    color: #22324a;
    z-index: 20;
  }

  .search-help-pop.show {
    display: block;
  }

  .manual-entry-ui {
    border: 1px solid #9aa0ad;
    background: #ececed;
    padding: 18px;
    min-height: calc(74vh - 70px);
    position: relative;
    display: none;
  }

  .manual-entry-ui .manual-subtabs,
  .manual-entry-ui .manual-label,
  .manual-entry-ui .manual-display,
  .manual-entry-ui .manual-error,
  .manual-entry-ui .manual-gender-row,
  .manual-entry-ui .manual-hint,
  .manual-entry-ui .manual-keyboard-shell {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }

  .manual-subtabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid #9aa4be;
    padding-bottom: 10px;
  }

  .manual-subtab {
    border: 1px solid #c0c5cf;
    background: #d7d9de;
    color: #324865;
    padding: 10px 18px;
    font-size: 32px;
    font-weight: 700;
    cursor: pointer;
  }

  .manual-subtab.active {
    background: #fff;
    border: 2px solid #333;
    color: #000;
    padding: 9px 17px;
  }

  .manual-label {
    display: none;
    margin: 12px 0 8px;
    font-size: 44px;
    color: #111;
  }

  .manual-display {
    border: 1px solid #c4c8d0;
    background: #f4f4f4;
    min-height: 118px;
    padding: 20px 16px;
    font-size: 42px;
    color: #8a97ad;
    margin-bottom: 14px;
    box-sizing: border-box;
  }

  .manual-error {
    min-height: 24px;
    margin: -6px 0 8px;
    color: #b00020;
    font-size: 24px;
    font-weight: 700;
  }

  .manual-hint {
    display: block;
    min-height: 24px;
    margin: 0 0 10px;
    color: #2f3f58;
    font-size: 20px;
    font-weight: 700;
  }

  .manual-gender-row {
    display: flex;
    gap: 10px;
    margin: -2px 0 10px;
  }

  .manual-gender-btn {
    border: 1px solid #7d8798;
    background: #f4f5f7;
    color: #1f2937;
    font-size: 16px;
    font-weight: 700;
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
  }

  .manual-gender-btn.active {
    background: #2f66e5;
    border-color: #1e4fbf;
    color: #fff;
  }

  .manual-cursor {
    color: #222;
    animation: scanPulse 1.2s ease-in-out infinite;
  }

  .manual-keyboard-shell {
    border: 1px solid #9aa4be;
    border-radius: 20px;
    background: #efeff0;
    padding: 20px 18px 14px;
    margin-bottom: 20px;
  }

  .manual-results {
    width: 100%;
    margin: 0 auto 24px;
    border: 1px solid #9aa4be;
    border-radius: 12px;
    background: #f7f8fb;
    display: none;
    max-height: 280px;
    overflow-y: auto;
  }

  .manual-result-item {
    border-bottom: 1px solid #d4d9e5;
    padding: 10px 12px;
    cursor: pointer;
    font-size: 16px;
    color: #182437;
    line-height: 1.35;
  }

  .manual-result-item:last-child {
    border-bottom: 0;
  }

  .manual-result-item.active {
    background: #dce8ff;
  }

  .manual-keyboard-row {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: nowrap;
  }

  .manual-key {
    border: 1px solid #253689;
    border-radius: 12px;
    color: #fff;
    font-weight: 700;
    font-size: 35px;
    min-width: 56px;
    height: 56px;
    padding: 0 16px;
    margin: 2px;
    flex: 1 1 0;
    background: linear-gradient(#5d7ed1, #2b4298);
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
  }

  .manual-key.wide {
    flex: 1.35 1 0;
  }

  .manual-key.extra-wide {
    flex: 1.8 1 0;
  }

  .hidden-manual-search {
    display: none;
    width: 100%;
    max-width: none;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 1700px) {
    .search-panel,
    .manual-entry-ui {
      min-height: 520px;
    }
  }

  @media (max-width: 1100px) {
    .manual-entry-ui .manual-subtabs,
    .manual-entry-ui .manual-label,
    .manual-entry-ui .manual-display,
    .manual-entry-ui .manual-error,
    .manual-entry-ui .manual-gender-row,
    .manual-entry-ui .manual-hint,
    .manual-entry-ui .manual-keyboard-shell {
      width: 100%;
      margin-left: 0;
    }
  }

  #btnHelp {
    display: none !important;
  }

  .hidekeyboard #keyboard {
    display: none !important;
  }

  .element {
    border: 1px solid #999;
    background-color: #cadcd3;
    color: #000;
    padding: 3px;
    margin: 3px;
    font-size: 24px;
    cursor: pointer;
    border-radius: 10px;
  }

  div.odd {
    background-color: #B2C4B4 !important;
  }

  div.highlighted {
    background-color: lightblue !important;
    color: #000;
  }

  div.female {
    border-radius: 150px;
    border-right: 5px solid magenta;
    border-bottom: 1px solid magenta;
    padding: 15px;
    color: magenta;
    background-color: rgba(223, 47, 229, 0.1);
    width: 260px;
    height: 260px;
    margin: auto;
  }

  div.male {
    border-radius: 150px;
    border-right: 5px solid #2f66e5;
    border-bottom: 1px solid #2f66e5;
    padding: 15px;
    color: blue;
    background-color: rgba(47, 102, 229, 0.1);
    width: 260px;
    height: 260px;
    margin: auto;
  }

  .arrow-up {
    width: 0;
    height: 0;
    border-left: 30px solid transparent;
    border-right: 30px solid transparent;
    cursor: pointer;
    border-bottom: 30px solid #3465a4;
  }

  .arrow-up:hover {
    border-bottom: 30px solid #5ca6c4;
  }

  .arrow-up:active {
    border-bottom: 30px solid #ef8544;
  }

  .arrow-down {
    width: 0;
    height: 0;
    border-left: 30px solid transparent;
    border-right: 30px solid transparent;
    cursor: pointer;
    border-top: 30px solid #3465a4;
  }

  .arrow-down:hover {
    border-top: 30px solid #5ca6c4;
  }

  .arrow-down:active {
    border-top: 30px solid #ef8544;
  }

</style>
<script type="text/javascript" defer>

    tt_cancel_destination = '/';
    tt_cancel_show = '/';


    var patients = [];
    var page = 1;

    var helpLinks = {
        "Find Patient": "<%= @settings["help_base_url"] rescue "" %>find_patient",
        "Register Patient": "<%= @settings["help_base_url"] rescue "" %>new_patient",
        "Cancel": "<%= @settings["help_base_url"] rescue "" %>cancel",
        "New Person": "<%= @settings["help_base_url"] rescue "" %>add_patient",
        "Select Person": "<%= @settings["help_base_url"] rescue "" %>select_patient"
    };

    function hidekeyboard() {
        if (__$("keyboard")) {
            __$("keyboard").style.display = "none";
        } else {
            setTimeout("hidekeyboard()", 100);
        }
    }

    function loadNames() {

        var panel = document.createElement("div");
        panel.style.borderRadius = "10px";
        panel.style.width = "99%";
        panel.style.height = "98%";
        panel.style.padding = "10px";

        __$("inputFrame" + tstCurrentPage).appendChild(panel);

        var tbl = document.createElement("div");
        tbl.style.display = "table";
        tbl.style.width = "100%";
        tbl.style.height = "100%";

        panel.appendChild(tbl);

        var row = document.createElement("div");
        row.style.display = "table-row";

        tbl.appendChild(row);

        var cell0 = document.createElement("div");
        cell0.style.display = "table-cell";
        cell0.style.height = "100%";
        cell0.style.verticalAlign = "top";

        row.appendChild(cell0);

        var cell1 = document.createElement("div");
        cell1.style.display = "table-cell";
        cell1.style.height = "100%";
        cell1.style.width = "70px";
        cell1.style.verticalAlign = "top";

        row.appendChild(cell1);

        var navpanel0 = document.createElement("div");
        navpanel0.style.width = "70px";
        navpanel0.style.height = "65vh";
        navpanel0.id = "navpanel0";
        navpanel0.style.cssFloat = "right";
        navpanel0.style.backgroundColor = "#e7efeb";
        navpanel0.style.overflow = "hidden";
        navpanel0.style.verticalAlign = "top";
        navpanel0.style.textAlign = "center";

        // cell1.appendChild(navpanel0);

        var navUp = document.createElement("div");
        navUp.id = "navUp";
        navUp.className = "arrow-up";
        navUp.style.margin = "auto";

        navUp.onmousedown = function () {
            if (page - 1 > 0) {
                page -= 1;
            }

            ajaxSearch(page);
        }

        // navpanel0.appendChild(navUp);

        var navpanel1 = document.createElement("div");
        navpanel1.style.width = "70px";
        navpanel1.style.height = "30px";
        navpanel1.id = "navpanel1";
        navpanel1.style.cssFloat = "right";
        navpanel1.style.backgroundColor = "#e7efeb";
        navpanel1.style.overflow = "hidden";
        navpanel1.style.verticalAlign = "bottom";

        // cell1.appendChild(navpanel1);

        var navDown = document.createElement("div");
        navDown.id = "navDown";
        navDown.className = "arrow-down";
        navDown.style.margin = "auto";

        navDown.onmousedown = function () {
            page += 1;

            ajaxSearch(page);
        }

        // navpanel1.appendChild(navDown);

        var leftpanel = document.createElement("div");
        leftpanel.style.border = "2px solid #B2C4B4";
        leftpanel.style.width = "49.3%";
        leftpanel.style.height = "70vh";
        leftpanel.id = "leftpanel";
        leftpanel.style.cssFloat = "left";
        leftpanel.style.borderRadius = "8px";
        leftpanel.style.backgroundColor = "#e7efeb";
        leftpanel.style.overflowX = "hidden";
        leftpanel.style.overflowY = "auto";

        // cell0.appendChild(leftpanel);

        var rightpanel = document.createElement("div");
        rightpanel.style.border = "2px solid #B2C4B4";
        rightpanel.style.width = "49.3%";
        rightpanel.style.height = "65vh";
        rightpanel.id = "rightpanel";
        rightpanel.style.cssFloat = "right";
        rightpanel.style.borderRadius = "10px";
        rightpanel.style.backgroundColor = "#e7efeb";
        rightpanel.style.overflow = "auto";

        // cell0.appendChild(rightpanel);

        var footer = document.createElement("div");
        footer.id = "extras";
        footer.style.cssFloat = "right";

        __$("buttons").appendChild(footer);

        var newPatient = document.createElement("button");
        newPatient.innerHTML = "<span>New Patient</span>";
        newPatient.id = "newPatient";
        newPatient.style.cssFloat = "right";

        newPatient.onmousedown = function () {
            window.location = "/patients/new?given_name=" + __$("given_name").value.trim() +
                "&family_name=" + __$("family_name").value.trim() + "&gender=" +
                __$("gender").value.trim();
        }

        footer.appendChild(newPatient);

        var btnRight = document.createElement("button");
        btnRight.innerHTML = "<span>&rarr;</span>";
        btnRight.id = "btnFirst";
        btnRight.style.cssFloat = "right";

        btnRight.onmousedown = function () {
            page += 1;

            if (__$("nextButton")) {
                __$("nextButton").className = "button gray navButton";
                __$("nextButton").onclick = function () {
                };
            }

            ajaxSearch(page);
        }

        // footer.appendChild(btnRight);

        var btnLeft = document.createElement("button");
        btnLeft.innerHTML = "<span>&larr;</span>";
        btnLeft.id = "btnFirst";
        btnLeft.style.cssFloat = "right";

        btnLeft.onmousedown = function () {
            if (page - 1 > 0) {
                page -= 1;
            }

            if (__$("nextButton")) {
                __$("nextButton").className = "button gray navButton";
                __$("nextButton").onclick = function () {
                };
            }

            ajaxSearch(page);
        }

        // footer.appendChild(btnLeft);

        var btnFirst = document.createElement("button");
        btnFirst.innerHTML = "<span>|&larr;</span>";
        btnFirst.id = "btnFirst";
        btnFirst.style.cssFloat = "right";

        btnFirst.onmousedown = function () {
            page = 1;

            if (__$("nextButton")) {
                __$("nextButton").className = "button gray navButton";
                __$("nextButton").onclick = function () {
                };
            }

            ajaxSearch(page);
        }

        // footer.appendChild(btnFirst);

        ajaxSearch(page);
    }

    function deselectAllAndSelect(me) {
        for (var i = 0; i < __$("rightpanel").children.length; i++) {
            if (__$("rightpanel").children[i].id == me) {
                __$("rightpanel").children[i].className = "element highlighted";
            } else {
                __$("rightpanel").children[i].className = "element " + (__$("rightpanel").children[i].getAttribute("tag") == "odd" ? "odd" : "");
            }
        }
    }

    function ajaxSearch(page) {
        var url = "/patients/ajax_search?given_name=" + __$("given_name").value.trim() +
            "&family_name=" + __$("family_name").value.trim() + "&gender=" +
            __$("gender").value.trim() + "&page=" + page;

        if (__$("nextButton")) {
            __$("nextButton").className = "button gray navButton";
            __$("nextButton").onclick = function () {
            };
        }

        var httpRequest = new XMLHttpRequest();
        httpRequest.onreadystatechange = function () {
            handleAjaxRequest(httpRequest);
        };
        try {
            httpRequest.open('GET', url, true);
            httpRequest.send(null);
        } catch (e) {
        }
    }

    function handleAjaxRequest(aXMLHttpRequest) {
        if (!aXMLHttpRequest) return;

        __$("leftpanel").innerHTML = "";
        __$("rightpanel").innerHTML = "";

        if (__$("nextButton")) {
            __$("nextButton").className = "button gray navButton";
            __$("nextButton").onclick = function () {
            };
        }

        if (aXMLHttpRequest.readyState == 4 && aXMLHttpRequest.status == 200) {

            var result = aXMLHttpRequest.responseText;

            patients = JSON.parse(result);

            if (Object.keys(patients).length == 0) {
                __$("rightpanel").innerHTML = "<div style='margin: auto; padding: 20px; font-size: 24px; font-style: italic;'>No results found!</div>";
            }

            for (var i = 0; i < patients.length; i++) {

                var div = document.createElement("div");
                div.id = i;
                div.className = "element " + (i % 2 > 0 ? "odd" : "");
                div.setAttribute("tag", (i % 2 > 0 ? "odd" : "even"));

                div.onclick = function () {
                    deselectAllAndSelect(this.id);

                    showPatient(this.id);

                    __$("patient").value = this.id;

                    if (__$('nextButton')) {
                        __$("nextButton").innerHTML = "<span>Select</span>"
                        __$("nextButton").className = "green navButton";

                        __$('nextButton').onmousedown = function () {
                            // if(this.getAttribute("local") == true){

                            // document.forms[0].setAttribute("action", "/patients/patient_by_id/");

                          /*} else {
                           document.forms[0].setAttribute("action", "/process_result");
                           }*/

                            document.forms[0].submit();
                        }
                    }
                }

                div.innerHTML = "<table width='100%'><tr><td style='width: 50%'>" +
                    patients[i]["names"]["given_name"] + " " + patients[i]["names"]["family_name"] +
                    " (" + patients[i]["age"] + ")" + "</td><td>" + patients[i]["national_id"] +
                    "</td><td style='width: 30px; background-color: white; border-radius: 60px; padding: 5px; border: 1px solid #666;'>" +
                    (patients[i]["gender"] == "M" ? "<img src='/assets/male.png' width='47px' alt='Male' />" :
                        (patients[i]["gender"] == "F" ? "<img src='/assets/female.png' width='47px' alt='Female' />" : "")) + "</td></tr></table>";

                __$("rightpanel").appendChild(div);

            }

        }

    }

    function showPatient(pos) {
        __$("leftpanel").innerHTML = "";

        if (__$("json")) {
            __$("json").innerHTML = JSON.stringify(patients[pos]);
        }

        var table = document.createElement("table");
        table.style.margin = "auto";
        table.style.paddingTop = "10px";
        table.setAttribute("cellpadding", 10);
        table.setAttribute("cellspacing", 0);
        table.style.fontSize = "1.2em";
        table.style.color = "#000";
        table.style.width = "100%";

        __$("leftpanel").appendChild(table);

        var tbody = document.createElement("tbody");

        table.appendChild(tbody);

        var tr1 = document.createElement("tr");

        tbody.appendChild(tr1);

        var cell1_1 = document.createElement("th");
        cell1_1.style.textAlign = "right";
        cell1_1.style.color = "#000";
        cell1_1.innerHTML = "Patient Name:";
        cell1_1.style.borderRight = "1px dotted #000";

        tr1.appendChild(cell1_1);

        var cell1_2 = document.createElement("td");
        cell1_2.style.fontStyle = "italic";
        cell1_2.innerHTML = patients[pos]["names"]["given_name"] + " " + patients[pos]["names"]["family_name"];

        tr1.appendChild(cell1_2);

        var tr2 = document.createElement("tr");

        tbody.appendChild(tr2);

        var cell2_1 = document.createElement("th");
        cell2_1.style.textAlign = "right";
        cell2_1.style.color = "#000";
        cell2_1.innerHTML = "Age:";
        cell2_1.style.borderRight = "1px dotted #000";

        tr2.appendChild(cell2_1);

        var cell2_2 = document.createElement("td");
        cell2_2.style.fontStyle = "italic";
        cell2_2.innerHTML = (patients[pos]["birthdate_estimated"] ? "~" : "") + patients[pos]["age"];

        tr2.appendChild(cell2_2);

        var tr3 = document.createElement("tr");

        tbody.appendChild(tr3);

        var cell3_1 = document.createElement("th");
        cell3_1.style.textAlign = "right";
        cell3_1.style.color = "#000";
        cell3_1.innerHTML = "National ID:";
        cell3_1.style.borderRight = "1px dotted #000";

        tr3.appendChild(cell3_1);

        var cell3_2 = document.createElement("td");
        cell3_2.style.fontStyle = "italic";
        cell3_2.innerHTML = patients[pos]["national_id"];

        tr3.appendChild(cell3_2);

        for (var k = 0; k < patients[pos]["patient"]["identifiers"].length; k++) {

            if (String(patients[pos]["patient"]["identifiers"][k][Object.keys(patients[pos]["patient"]["identifiers"][k])[0]]).trim().length <= 0)
                continue;

            var tr3 = document.createElement("tr");

            tbody.appendChild(tr3);

            var cell3_1 = document.createElement("th");
            cell3_1.style.textAlign = "right";
            cell3_1.style.color = "#000";
            cell3_1.innerHTML = Object.keys(patients[pos]["patient"]["identifiers"][k])[0] + ":";
            cell3_1.style.borderRight = "1px dotted #000";

            tr3.appendChild(cell3_1);

            var cell3_2 = document.createElement("td");
            cell3_2.style.fontStyle = "italic";
            cell3_2.innerHTML = patients[pos]["patient"]["identifiers"][k][Object.keys(patients[pos]["patient"]["identifiers"][k])[0]];

            tr3.appendChild(cell3_2);

        }

        var tr4 = document.createElement("tr");

        tbody.appendChild(tr4);

        var cell4_1 = document.createElement("th");
        cell4_1.style.textAlign = "right";
        cell4_1.style.color = "#000";
        cell4_1.innerHTML = "Gender:";
        cell4_1.style.borderRight = "1px dotted #000";

        tr4.appendChild(cell4_1);

        var cell4_2 = document.createElement("td");
        cell4_2.style.fontStyle = "italic";
      /*cell4_2.innerHTML = "<div class='" + (patients[pos]["gender"] == "M" ? "male" :
       (patients[pos]["gender"] == "F" ? "female" : "")) + "'>" + (patients[pos]["gender"] == "M" ? "<img src='/images/male.png' height='250' alt='Male' />" :
       (patients[pos]["gender"] == "F" ? "<img src='/images/female.png' height='250' alt='Female' />" : "")) + "</div>";*/

        cell4_2.innerHTML = (patients[pos]["gender"] == "M" ? "Male" : (patients[pos]["gender"] == "F" ? "Female" : ""));

        // cell4_2.setAttribute("align", "center");

        tr4.appendChild(cell4_2);

        var tr5 = document.createElement("tr");

        tbody.appendChild(tr5);

        var cell5_1 = document.createElement("th");
        cell5_1.style.textAlign = "right";
        cell5_1.style.color = "#000";
        cell5_1.innerHTML = "Residence:";
        cell5_1.style.borderRight = "1px dotted #000";

        tr5.appendChild(cell5_1);

        var cell5_2 = document.createElement("td");
        cell5_2.style.fontStyle = "italic";
        cell5_2.innerHTML = patients[pos]["addresses"]["current_village"];

        tr5.appendChild(cell5_2);

    }

</script>

<%= form_for :patients,  :url => process_result_patients_path  do |f| %>
    <% display_user = (current_user&.name.presence || "Admin User") %>
    <% display_role = (current_user&.user_roles&.first&.role.presence || "Superuser") %>
    <% display_location = (current_location&.name.presence || "Reception") %>
    <%= hidden_field_tag "patient", nil %>
    <div class="search-shell">
      <div id="header">
        <div class="confirm-top">
          <div class="confirm-top-main">
            <div class="confirm-top-title">Scan Patient Barcode</div>
            <div class="confirm-scan-row">
              <label class="confirm-scan-label" for="headerBarcodeInput">
                <img style="display: block;height: 28px;" src="/assets/barcode.jpg" alt="barcode icon">
                <span>Barcode</span>
              </label>
              <input id="headerBarcodeInput" type="text" class="scanner confirm-scan-input" autocomplete="off" autofocus>
            </div>
            <div class="confirm-meta">
              <div>Facility</div><div><%= facility_name %></div>
              <div>User</div><div><%= display_user %></div>
              <div>Location</div><div><%= display_location.titleize %></div>
              <div>Role</div><div><%= display_role %></div>
            </div>
          </div>
          <div class="confirm-brand">
            <strong>eBilling</strong>
            <span><%= Date.current.strftime('%d %b %Y') %></span>
          </div>
        </div>
      </div>

      <div class="search-body">
        <div class="search-tabs">
          <div class="search-tab active" id="scanTabBtn">Scan Barcode</div>
          <div class="search-tab" id="manualTabBtn">Manual Entry (Lost Card)</div>
        </div>

        <div class="search-panel" id="scanPanel">
          <div class="search-info-dot" id="searchInfoDot" title="Help">i</div>
          <div class="search-help-pop" id="searchHelpPop">
            Scan the patient barcode to auto-find records. Use Manual Entry if the card is unavailable.
          </div>
          <h2>Patient Barcode</h2>
          <div class="scan-zone"><span class="scan-status" id="scanStatusText">Awaiting scan...</span></div>
          <div class="scan-note">
            Aim the scanner at the barcode on the patient's health passport. The system will look up the record automatically.
          </div>
        </div>

        <div class="manual-entry-ui" id="manualEntryUi">
          <div class="search-info-dot" title="Help">i</div>
          <div class="manual-subtabs">
            <div class="manual-subtab active" id="subtabGiven">Firstname</div>
            <div class="manual-subtab" id="subtabFamily">Surname</div>
            <div class="manual-subtab" id="subtabDob">DD/MM/YYYY</div>
          </div>
          <div class="manual-label" id="manualFieldLabel">First Name</div>
          <div class="manual-display" id="manualDisplayValue"></div>
          <div class="manual-error" id="manualDobError"></div>
          <div class="manual-gender-row">
            <button type="button" class="manual-gender-btn" id="manualGenderFemale">Female</button>
            <button type="button" class="manual-gender-btn" id="manualGenderMale">Male</button>
          </div>
          <div class="manual-hint" id="manualSearchHint"></div>

          <div class="manual-keyboard-shell">
            <div id="manualKeyboardRows"></div>
          </div>
          <div class="manual-results" id="manualResultsList"></div>
        </div>
      </div>

      <table width='100%' cellpadding=10 cellspacing=0 class="hidden-manual-search" id="manualSearchPanel">
      <tr>
        <td colspan="2" style="padding-bottom: 10px; border-bottom: 1px dotted #999;">
          <div style="font-size: 14px; color: #555;">
            <a href="/patients/scan" style="color: #2f66e5; text-decoration: none; font-weight: bold;"> Scan Patient Label</a>
            <span style="color: #999;"> | </span>
            <span style="color: #666;">or search manually below</span>
          </div>
        </td>
      </tr>
      <tr>
        
        <td>
          <input type="text" id="given_name" name="given_name" value="" helpText="First Name"
                 allowFreeText=true />
        </td>
      </tr>
      <tr>
        <td>
      Last  Name
        </td>
        <td>
          <input type="text" id="family_name" name="family_name" value="" helpText="Family Name"
                  allowFreeText=true
                 tt_onLoad="loadNames();__$('nextButton').onmousedown = function(){};" optional="true"/>
        </td>
      </tr>
      <tr>
        <td>
          Gender
        </td>
        <td>
          
          <select id="gender" name="gender" value="" helpText="Gender" condition="<%= (!@globals["default_gender_female"].nil? and @globals["default_gender_female"] == true ? false : true) %>">
            <option></option>
            <option value="F" <%= (!@globals["default_gender_female"].nil? and @globals["default_gender_female"] == true ? "selected" : "") %> >Female</option>
            <option value="M">Male</option>
          </select>
        </td>
      </tr>
      </table>
      </div>

      <div class="search-actions">
        <button type="button" class="action-btn cancel" id="searchCancelBtn">Cancel</button>
        <div class="search-actions-right">
          <button type="button" class="action-btn" id="searchNewPatientBtn">New Patient</button>
          <button type="button" class="action-btn" id="searchClearBtn">Clear</button>
          <button type="button" class="action-btn" id="searchBackBtn">Back</button>
          <button type="button" class="action-btn disabled" id="searchNextBtn">Next</button>
        </div>
      </div>
    </div>

    <textarea id="json" name="person" condition=false></textarea>

<% end %>
<script src="/assets/bht-help.js" defer></script>
<script type="text/javascript" defer>
  (function () {
    function byId(id) { return document.getElementById(id); }
    function focusHeaderBarcodeInput() {
      var barcodeInput = byId("headerBarcodeInput");
      if (barcodeInput) {
        barcodeInput.focus();
      }
    }

    function setScanStatus(text) {
      var status = byId("scanStatusText");
      if (status) status.textContent = text;
    }

    setTimeout(focusHeaderBarcodeInput, 0);
    setTimeout(function () { setScanStatus("Ready to scan..."); }, 0);

    var headerBarcodeInput = byId("headerBarcodeInput");
    if (headerBarcodeInput) {
      headerBarcodeInput.addEventListener("input", function () {
        if (headerBarcodeInput.value.trim().length > 0) {
          setScanStatus("Scanning...");
        } else {
          setScanStatus("Ready to scan...");
        }
      });

      headerBarcodeInput.addEventListener("keydown", function (event) {
        if (event.key !== "Enter") return;
        event.preventDefault();
        var code = headerBarcodeInput.value.trim().replace(/\s+/g, "");
        if (!code) {
          setScanStatus("Ready to scan...");
          return;
        }
        setScanStatus("Processing scan...");
        window.location = "/patients/patient_by_id/" + encodeURIComponent(code) + "?source=scan";
      });
    }

    function setNextEnabled(enabled) {
      var nextBtn = byId("searchNextBtn");
      if (!nextBtn) return;
      if (enabled) {
        nextBtn.classList.remove("disabled");
      } else {
        nextBtn.classList.add("disabled");
      }
    }

    function setManualHint(text, isError) {
      var hint = byId("manualSearchHint");
      if (!hint) return;
      hint.textContent = text || "";
      hint.style.color = isError ? "#b00020" : "#2f3f58";
    }

    function setManualGender(genderValue) {
      var genderSelect = byId("gender");
      if (genderSelect) genderSelect.value = genderValue;
      var femaleBtn = byId("manualGenderFemale");
      var maleBtn = byId("manualGenderMale");
      if (femaleBtn) femaleBtn.classList.toggle("active", genderValue === "F");
      if (maleBtn) maleBtn.classList.toggle("active", genderValue === "M");
    }

    var manualSearchResults = [];
    var selectedManualPatientId = null;

    function getManualPatientId(entry) {
      return (entry && entry.patient_id) ? String(entry.patient_id) : "";
    }

    function formatManualDob(value) {
      if (!value) return "-";
      var dateObj = new Date(value);
      if (isNaN(dateObj.getTime())) return String(value);
      var d = String(dateObj.getDate()).padStart(2, "0");
      var m = String(dateObj.getMonth() + 1).padStart(2, "0");
      var y = dateObj.getFullYear();
      return d + "/" + m + "/" + y;
    }

    function renderManualResultsList() {
      var wrap = byId("manualResultsList");
      if (!wrap) return;
      wrap.innerHTML = "";

      if (!manualSearchResults || manualSearchResults.length <= 1) {
        wrap.style.display = "none";
        return;
      }

      wrap.style.display = "block";

      manualSearchResults.forEach(function (entry) {
        var pid = getManualPatientId(entry);
        if (!pid) return;

        var item = document.createElement("div");
        item.className = "manual-result-item" + (selectedManualPatientId === pid ? " active" : "");

        var addresses = entry.addresses || {};
        var dob = formatManualDob(entry.birthdate);
        var district = addresses.home_district || addresses.current_district || "-";
        var village = addresses.home_village || addresses.current_village || "-";
        var ta = addresses.home_ta || addresses.current_ta || "-";

        item.textContent = "Patient ID: " + pid +
          " | DOB: " + dob +
          " | District: " + district +
          " | Village: " + village +
          " | Home T/A: " + ta;

        item.onclick = function () {
          selectedManualPatientId = pid;
          renderManualResultsList();
          setManualHint("Selected Patient ID " + pid + ". Tap Next to continue.", false);
        };

        wrap.appendChild(item);
      });
    }

    function clearManualResultsState() {
      manualSearchResults = [];
      selectedManualPatientId = null;
      var wrap = byId("manualResultsList");
      if (wrap) {
        wrap.innerHTML = "";
        wrap.style.display = "none";
      }
    }

    function getSelectedPatientId() {
      var selected = document.querySelector("#rightpanel .element.highlighted");
      return selected ? selected.id : null;
    }

    document.addEventListener("click", function (e) {
      var infoDot = byId("searchInfoDot");
      var helpPop = byId("searchHelpPop");
      if (!infoDot || !helpPop) return;

      if (e.target === infoDot) {
        helpPop.classList.toggle("show");
        return;
      }

      if (!helpPop.contains(e.target)) {
        helpPop.classList.remove("show");
      }
    });

    var cancelBtn = byId("searchCancelBtn");
    if (cancelBtn) {
      cancelBtn.onclick = function () {
        window.location = "/";
      };
    }

    var newPatientBtn = byId("searchNewPatientBtn");
    if (newPatientBtn) {
      newPatientBtn.onclick = function () {
        var given = (byId("given_name") ? byId("given_name").value.trim() : "");
        var family = (byId("family_name") ? byId("family_name").value.trim() : "");
        var gender = (byId("gender") ? byId("gender").value.trim() : "");
        window.location = "/patients/new?given_name=" + encodeURIComponent(given) +
          "&family_name=" + encodeURIComponent(family) +
          "&gender=" + encodeURIComponent(gender);
      };
    }

    var clearBtn = byId("searchClearBtn");
    if (clearBtn) {
      clearBtn.onclick = function () {
        if (byId("given_name")) byId("given_name").value = "";
        if (byId("family_name")) byId("family_name").value = "";
        if (byId("birthdate")) byId("birthdate").value = "";
        if (byId("gender")) byId("gender").selectedIndex = 0;
        if (byId("patient")) byId("patient").value = "";
        if (byId("leftpanel")) byId("leftpanel").innerHTML = "";
        if (byId("rightpanel")) byId("rightpanel").innerHTML = "";
        setNextEnabled(false);
        setManualGender("");
        clearManualResultsState();
        refreshManualDisplay();
      };
    }

    var backBtn = byId("searchBackBtn");
    if (backBtn) {
      backBtn.onclick = function () {
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location = "/";
        }
      };
    }

    var nextBtn = byId("searchNextBtn");
    if (nextBtn) {
      nextBtn.onclick = function () {
        if (nextBtn.classList.contains("disabled")) return;

        var manualTab = byId("manualTabBtn");
        if (manualTab && manualTab.classList.contains("active")) {
          if (!validateDob(true)) return;

          var given = (byId("given_name") ? byId("given_name").value.trim() : "");
          var family = (byId("family_name") ? byId("family_name").value.trim() : "");
          var gender = (byId("gender") ? byId("gender").value.trim() : "");

          if (!given || !family || !gender) {
            setManualHint("Enter First Name, Surname, and Gender, then tap Next.", true);
            return;
          }

          if (manualSearchResults.length > 1) {
            if (!selectedManualPatientId) {
              setManualHint("Multiple matches found. Select the correct patient first.", true);
              return;
            }
            window.location = "/patients/patient_demographics/" + encodeURIComponent(selectedManualPatientId) + "?source=manual";
            return;
          }

          setManualHint("Searching patient records...", false);
          clearManualResultsState();
          var url = "/patients/ajax_search?given_name=" + encodeURIComponent(given) +
            "&family_name=" + encodeURIComponent(family) +
            "&gender=" + encodeURIComponent(gender) + "&page=1";

          var req = new XMLHttpRequest();
          req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            if (req.status !== 200) {
              setManualHint("Search failed. Please try again.", true);
              return;
            }
            var results = [];
            try { results = JSON.parse(req.responseText || "[]"); } catch (e) { results = []; }
            if (!results || results.length === 0) {
              setManualHint("No matching patient found.", true);
              return;
            }

            var withPatientId = results.filter(function (entry) { return getManualPatientId(entry) !== ""; });
            if (!withPatientId.length) {
              setManualHint("Matching records found, but Patient ID is missing.", true);
              return;
            }

            if (withPatientId.length === 1) {
              window.location = "/patients/patient_demographics/" + encodeURIComponent(getManualPatientId(withPatientId[0])) + "?source=manual";
              return;
            }

            manualSearchResults = withPatientId;
            selectedManualPatientId = null;
            renderManualResultsList();
            setManualHint("Multiple matches found. Select the correct patient, then tap Next.", true);
          };
          req.open("GET", url, true);
          req.send(null);
          return;
        }

        var barcodeInput = byId("headerBarcodeInput");
        var barcode = barcodeInput ? barcodeInput.value.trim().replace(/\s+/g, "") : "";
        if (barcode.length > 0) {
          window.location = "/patients/patient_by_id/" + encodeURIComponent(barcode) + "?source=scan";
          return;
        }
        setScanStatus("Enter/scan a barcode, then tap Next.");

        var selectedId = getSelectedPatientId();
        if (!selectedId) return;
        var selectedPatient = (patients && typeof patients[selectedId] !== "undefined") ? patients[selectedId] : null;
        if (!selectedPatient) return;

        if (selectedPatient.patient_id) {
          window.location = "/patients/patient_demographics/" + encodeURIComponent(selectedPatient.patient_id) + "?source=scan";
          return;
        }

        if (selectedPatient.national_id) {
          window.location = "/patients/patient_by_id/" + encodeURIComponent(selectedPatient.national_id) + "?source=scan";
          return;
        }
      };
    }

    function activateScanTab() {
      var scanTab = byId("scanTabBtn");
      var manualTab = byId("manualTabBtn");
      var scanPanel = byId("scanPanel");
      var manualPanel = byId("manualSearchPanel");
      var manualEntryUi = byId("manualEntryUi");
      if (scanTab) scanTab.classList.add("active");
      if (manualTab) manualTab.classList.remove("active");
      if (scanPanel) scanPanel.style.display = "block";
      if (manualPanel) manualPanel.style.display = "none";
      if (manualEntryUi) manualEntryUi.style.display = "none";
      clearManualResultsState();
      setNextEnabled(true);
      focusHeaderBarcodeInput();
    }

    var activeManualField = "given_name";
    var manualKeyboardMode = "alpha";

    function getManualPlaceholder() {
      if (activeManualField === "given_name") return "Enter first name...";
      if (activeManualField === "family_name") return "Enter surname...";
      return "DD/MM/YYYY";
    }

    function getActiveManualInput() {
      return byId(activeManualField);
    }

    function refreshManualDisplay() {
      var label = byId("manualFieldLabel");
      if (label) {
        label.textContent = activeManualField === "given_name" ? "First Name" :
          (activeManualField === "family_name" ? "Surname" : "Date of Birth");
      }

      var display = byId("manualDisplayValue");
      if (!display) return;
      var input = getActiveManualInput();
      var value = input ? input.value : "";
      var shown = value && value.length > 0 ? value : getManualPlaceholder();
      display.innerHTML = "";
      display.appendChild(document.createTextNode(shown));
      var cursor = document.createElement("span");
      cursor.className = "manual-cursor";
      cursor.textContent = "|";
      display.appendChild(cursor);
      validateDob(false);
    }

    function validateDob(showError) {
      var errorEl = byId("manualDobError");
      var dobInput = byId("birthdate");
      if (!errorEl || !dobInput) return true;
      errorEl.textContent = "";

      var value = (dobInput.value || "").trim();
      if (!value) return true;

      if (!/^\d{2}\/\d{2}\/\d{4}$/.test(value)) {
        if (showError) errorEl.textContent = "Use DD/MM/YYYY format";
        return false;
      }

      var parts = value.split("/");
      var day = parseInt(parts[0], 10);
      var month = parseInt(parts[1], 10);
      var year = parseInt(parts[2], 10);
      if (month < 1 || month > 12) {
        if (showError) errorEl.textContent = "Month must be 01-12";
        return false;
      }

      var maxDay = new Date(year, month, 0).getDate();
      if (day < 1 || day > maxDay) {
        if (showError) errorEl.textContent = "Day is not valid for that month";
        return false;
      }

      var dateObj = new Date(year, month - 1, day);
      if (dateObj.getFullYear() !== year || dateObj.getMonth() !== (month - 1) || dateObj.getDate() !== day) {
        if (showError) errorEl.textContent = "Invalid date";
        return false;
      }

      var today = new Date();
      today.setHours(0, 0, 0, 0);
      if (dateObj > today) {
        if (showError) errorEl.textContent = "Date of birth cannot be in the future";
        return false;
      }

      return true;
    }

    function formatDobDigits(rawValue) {
      var digits = (rawValue || "").replace(/\D/g, "").slice(0, 8);
      if (digits.length <= 2) return digits;
      if (digits.length <= 4) return digits.slice(0, 2) + "/" + digits.slice(2);
      return digits.slice(0, 2) + "/" + digits.slice(2, 4) + "/" + digits.slice(4);
    }

    function setManualField(fieldName) {
      activeManualField = fieldName;
      var isDob = fieldName === "birthdate";
      manualKeyboardMode = isDob ? "numeric" : "alpha";
      var given = byId("subtabGiven");
      var family = byId("subtabFamily");
      var dob = byId("subtabDob");
      if (given) given.classList.toggle("active", fieldName === "given_name");
      if (family) family.classList.toggle("active", fieldName === "family_name");
      if (dob) dob.classList.toggle("active", fieldName === "birthdate");

      renderManualKeyboard();
      refreshManualDisplay();
    }

    function keyButton(label, cssClass, action) {
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "manual-key" + (cssClass ? " " + cssClass : "");
      btn.textContent = label;
      btn.onclick = action;
      return btn;
    }

    function appendManualValue(text) {
      var input = getActiveManualInput();
      if (!input) return;
      if (activeManualField === "birthdate") {
        input.value = formatDobDigits(input.value + text);
      } else {
        input.value = input.value + text;
      }
      refreshManualDisplay();
    }

    function deleteManualValue() {
      var input = getActiveManualInput();
      if (!input) return;
      if (activeManualField === "birthdate") {
        input.value = formatDobDigits(input.value.slice(0, -1));
      } else {
        input.value = input.value.slice(0, -1);
      }
      refreshManualDisplay();
    }

    function renderManualKeyboard() {
      var rowsWrap = byId("manualKeyboardRows");
      if (!rowsWrap) return;
      rowsWrap.innerHTML = "";

      if (manualKeyboardMode === "alpha") {
        var row1 = document.createElement("div");
        row1.className = "manual-keyboard-row";
        "QWERTYUIOP".split("").forEach(function (ch) { row1.appendChild(keyButton(ch, "", function () { appendManualValue(ch); })); });
        row1.appendChild(keyButton("Delete", "wide", deleteManualValue));
        rowsWrap.appendChild(row1);

        var row2 = document.createElement("div");
        row2.className = "manual-keyboard-row";
        "ASDFGHJKL'".split("").forEach(function (ch) { row2.appendChild(keyButton(ch, "", function () { appendManualValue(ch); })); });
        row2.appendChild(keyButton("O-9", "wide", function () { manualKeyboardMode = "numeric"; renderManualKeyboard(); }));
        rowsWrap.appendChild(row2);

        var row3 = document.createElement("div");
        row3.className = "manual-keyboard-row";
        "ZXCVBNM,.".split("").forEach(function (ch) { row3.appendChild(keyButton(ch, "", function () { appendManualValue(ch); })); });
        row3.appendChild(keyButton("Space", "wide", function () { appendManualValue(" "); }));
        rowsWrap.appendChild(row3);
      } else {
        var rowNum = document.createElement("div");
        rowNum.className = "manual-keyboard-row";
        "1234567890".split("").forEach(function (ch) { rowNum.appendChild(keyButton(ch, "", function () { appendManualValue(ch); })); });
        rowNum.appendChild(keyButton("Delete", "wide", deleteManualValue));
        rowsWrap.appendChild(rowNum);

        var rowToggle = document.createElement("div");
        rowToggle.className = "manual-keyboard-row";
        rowToggle.appendChild(keyButton("A-Z", "wide", function () { manualKeyboardMode = "alpha"; renderManualKeyboard(); }));
        rowsWrap.appendChild(rowToggle);
      }
    }

    function activateManualTab() {
      var scanTab = byId("scanTabBtn");
      var manualTab = byId("manualTabBtn");
      var scanPanel = byId("scanPanel");
      var manualPanel = byId("manualSearchPanel");
      var manualEntryUi = byId("manualEntryUi");
      if (scanTab) scanTab.classList.remove("active");
      if (manualTab) manualTab.classList.add("active");
      if (scanPanel) scanPanel.style.display = "none";
      if (manualPanel) manualPanel.style.display = "none";
      if (manualEntryUi) manualEntryUi.style.display = "block";
      clearManualResultsState();
      setManualField("given_name");
      var currentGender = byId("gender") ? byId("gender").value : "";
      if (!currentGender) currentGender = "F";
      setManualGender(currentGender);
      setManualHint("Enter First Name, Surname, and Gender, then tap Next.", false);
      setNextEnabled(true);
    }

    var scanTabBtn = byId("scanTabBtn");
    if (scanTabBtn) scanTabBtn.onclick = activateScanTab;

    var manualTabBtn = byId("manualTabBtn");
    if (manualTabBtn) manualTabBtn.onclick = activateManualTab;
    var manualGenderFemaleBtn = byId("manualGenderFemale");
    if (manualGenderFemaleBtn) manualGenderFemaleBtn.onclick = function () { setManualGender("F"); };
    var manualGenderMaleBtn = byId("manualGenderMale");
    if (manualGenderMaleBtn) manualGenderMaleBtn.onclick = function () { setManualGender("M"); };

    var subtabGiven = byId("subtabGiven");
    if (subtabGiven) subtabGiven.onclick = function () {
      if (activeManualField === "birthdate" && !validateDob(true)) return;
      setManualField("given_name");
    };
    var subtabFamily = byId("subtabFamily");
    if (subtabFamily) subtabFamily.onclick = function () {
      if (activeManualField === "birthdate" && !validateDob(true)) return;
      setManualField("family_name");
    };
    var subtabDob = byId("subtabDob");
    if (subtabDob) subtabDob.onclick = function () { setManualField("birthdate"); };

    var birthInput = document.createElement("input");
    birthInput.type = "hidden";
    birthInput.id = "birthdate";
    birthInput.name = "birthdate";
    var formEl = document.forms[0];
    if (formEl) formEl.appendChild(birthInput);
    birthInput.addEventListener("blur", function () { validateDob(true); });

    var resultsObserver = new MutationObserver(function () {
      var manualActive = byId("manualTabBtn") && byId("manualTabBtn").classList.contains("active");
      var scanActive = byId("scanTabBtn") && byId("scanTabBtn").classList.contains("active");
      if (manualActive || scanActive) {
        setNextEnabled(true);
        return;
      }
      setNextEnabled(!!getSelectedPatientId());
    });

    function startObserverWhenPanelReady() {
      var rightPanel = byId("rightpanel");
      if (rightPanel) {
        resultsObserver.observe(rightPanel, { childList: true, subtree: true, attributes: true, attributeFilter: ["class"] });
      } else {
        setTimeout(startObserverWhenPanelReady, 250);
      }
    }

    startObserverWhenPanelReady();
    activateScanTab();
    setNextEnabled(true);
  })();
</script>
