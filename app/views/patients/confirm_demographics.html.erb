<% has_results = @results.respond_to?(:length) && @results.length > 0 %>
<%
  known_landmarks = ["market", "school", "police", "church", "borehole", "graveyard"]
  address_lines = lambda do |addresses, fields|
    lines = []
    seen = {}
    has_current_residence = addresses["current_residence"].present? rescue false

    fields.each do |field|
      value = addresses[field].to_s.strip rescue ""
      next if value.blank?
      next if field == "current_ta" && has_current_residence && known_landmarks.include?(value.downcase)
      next if seen[value.downcase]

      lines << value
      seen[value.downcase] = true
    end

    lines
  end
%>
