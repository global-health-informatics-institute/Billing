<script type="text/javascript">
    <!--
 
    var json = JSON.stringify(<%= raw @json.to_json %>);
    var people = [];
    var capturedBirthdate = "<%= @json['birthdate'] rescue '' %>";
    var sortedPeople = [];
    
    function compareBirthdates(birthdate1, birthdate2) {
        var score = 0;
        birthdate1 = (birthdate1 || "").toString();
        birthdate2 = (birthdate2 || "").toString();
        
        for (var i = 0; i < Math.min(birthdate1.length, birthdate2.length); i++) {
            if (birthdate1[i] === birthdate2[i]) {
                score += 1;
            }
        }
        return score;
    }
    
    function highlightBirthdate(birthdate1, birthdate2) {
        birthdate1 = (birthdate1 || "").toString();
        birthdate2 = (birthdate2 || "").toString();
        var result = '<span style="font-weight: bold;">DOB:</span> ';
        
        for (var i = 0; i < birthdate2.length; i++) {
            if (birthdate1[i] === birthdate2[i]) {
                result += '<span style="color: green; font-weight: bold;">' + birthdate2[i] + '</span>';
            } else {
                result += '<span style="color: red;">' + birthdate2[i] + '</span>';
            }
        }
        return result;
    }

    function formatAddress(addresses, fields, separator) {
        addresses = addresses || {};
        var values = [];
        var seen = {};
        var knownLandmarks = {"market": true, "school": true, "police": true, "church": true, "borehole": true, "graveyard": true};
        var hasCurrentResidence = addresses.current_residence != null && addresses.current_residence.toString().trim() != "";

        for (var i = 0; i < fields.length; i++) {
            var value = addresses[fields[i]] != null ? addresses[fields[i]].toString().trim() : "";

            if (fields[i] == "current_ta" && hasCurrentResidence && knownLandmarks[value.toLowerCase()]) {
                continue;
            }

            if (value != "" && !seen[value.toLowerCase()]) {
                values.push(value);
                seen[value.toLowerCase()] = true;
            }
        }

        return values.length > 0 ? values.join(separator) : "N/A";
    }

    function ajaxProcessRequest(target) {
        var url = "/patients/process_confirmation";

        var httpRequest = new XMLHttpRequest();
        httpRequest.onreadystatechange = function () {
            handleAjaxProcessRequest(httpRequest, target);
        };
        try {
            httpRequest.open("POST", url, true);
            httpRequest.setRequestHeader("Content-type", "application/json;charset=UTF-8");
            httpRequest.send(JSON.stringify({"person": json, "target": target, authenticity_token: '<%= form_authenticity_token %>'}));
        } catch (e) {
        }
    }

    function handleAjaxProcessRequest(aXMLHttpRequest, target) {

        if (!aXMLHttpRequest) return;

        if (aXMLHttpRequest.readyState == 4 && (aXMLHttpRequest.status == 200 ||
            aXMLHttpRequest.status == 304)) {

            var result = aXMLHttpRequest.responseText;

            try {
                var parsedResult = JSON.parse(result);

                if (typeof parsedResult == "string") {
                    parsedResult = JSON.parse(parsedResult);
                }

                if (target == "create") {
                    parsedResult["print_barcode"] = true;
                }

                result = JSON.stringify(parsedResult);
            } catch (e) {
            }

            submitForm = document.createElement("FORM");
            submitForm.setAttribute("type","hidden");
            document.body.appendChild(submitForm);
            submitForm.method = "POST";
            submitForm.action= "/patients/process_result";

            newElement = document.createElement("input")
            newElement.setAttribute("name", "person" )
            newElement.setAttribute("type","hidden");
            newElement.value = result;
            submitForm.appendChild(newElement);

            newElement = document.createElement("input")
            newElement.setAttribute("name", "authenticity_token" )
            newElement.setAttribute("type","hidden");
            newElement.value = '<%= form_authenticity_token.to_s %>';
            submitForm.appendChild(newElement);

            submitForm.submit();

        }
    }

    function ajaxRequest(page) {
        var url = "/patients/ajax_process_data";

        var httpRequest = new XMLHttpRequest();
        httpRequest.onreadystatechange = function () {
            handleAjaxRequest(httpRequest, page);
        };
        try {
            httpRequest.open("POST", url, true);
            httpRequest.setRequestHeader("Content-type", "application/json;charset=UTF-8");
            httpRequest.send(JSON.stringify({person: json, page: page, authenticity_token: '<%= form_authenticity_token %>'}));
        } catch (e) {
        }
    }

    function handleAjaxRequest(aXMLHttpRequest, page) {
        if (!aXMLHttpRequest) return;

        if (aXMLHttpRequest.readyState == 4 && (aXMLHttpRequest.status == 200 ||
            aXMLHttpRequest.status == 304)) {

            var result = aXMLHttpRequest.responseText;

            people = JSON.parse(result);

            if (__$("btnSelect")) {
                __$("btnSelect").className = "button_orange";
                __$("btnSelect").removeAttribute("onclick");
            }

            if (__$("btnUpdate")) {
                __$("btnUpdate").className = "button_gray";
                __$("btnUpdate").removeAttribute("onclick");
            }

            if (people.length <= 0 || people.length < <%= (CONFIG["pagesize"].to_i rescue 9) %>) {
                if (__$("btnRight")) {
                    __$("btnRight").className = "arrow-down";
                    __$("btnRight").removeAttribute("onclick");
                }
            } else {
                if (__$("btnRight")) {
                    __$("btnRight").className = "arrow-down";

                    __$("btnRight").setAttribute("tag", parseInt(page) + 1);

                    __$("btnRight").onclick = function () {
                        ajaxRequest(this.getAttribute("tag"));
                    }
                }
            }

            if (page == 1) {
                if (__$("btnLeft")) {
                    __$("btnLeft").className = "arrow-up";
                    __$("btnLeft").removeAttribute("onclick");
                }
            } else {
                if (__$("btnLeft")) {
                    __$("btnLeft").className = "arrow-up";

                    __$("btnLeft").setAttribute("tag", parseInt(page) - 1);

                    __$("btnLeft").onclick = function () {
                        ajaxRequest(this.getAttribute("tag"));
                    }
                }
            }

            if (__$("matched")) {
                __$("matched").innerHTML = "&nbsp;";
            }

            if (__$("selections")) {
                __$("selections").innerHTML = "";

                if (people.length <= 0) {
                    __$("selections").innerHTML = "<div style='width: 100%; height: 100%; font-size: 36px; text-align: center; padding-top: 60px;'>No match found</div>";

                    if (__$("matched")) {
                        __$("matched").innerHTML = "<div style='width: 100%; height: 100%; font-size: 36px; text-align: center; padding-top: 60px;'>No match found</div>";
                    }

                    return;
                }

                var ul = document.createElement("ul");
                ul.id = "options";
                ul.className = "listing";

                __$("selections").appendChild(ul);

                var gender = {M: "Male", F: "Female"};

                sortedPeople = people.slice().sort(function(a, b) {
                    var scoreA = compareBirthdates(capturedBirthdate, JSON.parse(a)["birthdate"]);
                    var scoreB = compareBirthdates(capturedBirthdate, JSON.parse(b)["birthdate"]);
                    return scoreB - scoreA;
                });

                for (var i = 0; i < sortedPeople.length; i++) {
                    var obj = JSON.parse(sortedPeople[i]);

                    var li = document.createElement("li");
                    li.id = i;
                    li.style.cursor = "pointer";
                    li.style.backgroundColor = (i % 2 == 0 ? "#eee" : "");
                    li.style.border = (i % 2 > 0 ? "1px solid #eee" : "");
                    
                    var matchScore = compareBirthdates(capturedBirthdate, (obj["birthdate_estimated"] ? "~" : "") + obj["birthdate"]);
                    var matchPercent = capturedBirthdate.length > 0 ? Math.round((matchScore / capturedBirthdate.length) * 100) : 0;
                    
                    li.innerHTML = obj["names"]["given_name"] + " " + obj["names"]["family_name"] + " (" + gender[obj["gender"]] + " - " + obj["_id"] + ") <span style='float: right; background: " + (matchPercent >= 50 ? "#4CAF50" : "#f44336") + "; color: white; padding: 4px 10px; border-radius: 4px; font-size: 18px; font-weight: bold;'>" + matchPercent + "% Match</span><br/>" + highlightBirthdate(capturedBirthdate, (obj["birthdate_estimated"] ? "~" : "") + obj["birthdate"]);

                    li.onclick = function () {
                        for (var j = 0; j < __$("options").children.length; j++) {
                            if (__$("options").children[j].id != this.id) {
                                __$("options").children[j].removeAttribute("class");
                            }
                        }

                        this.className = "selected";

                        loadData(this.id);
                    }

                    ul.appendChild(li);
                }
            }


        }
    }

function loadData(pos) {
         if (__$("matched")) {
             __$("matched").innerHTML = "";

             var originalIndex = sortedPeople[pos];
             var obj = JSON.parse(originalIndex);
             
             var matchScore = compareBirthdates(capturedBirthdate, (obj.birthdate_estimated ? "~" : "") + obj.birthdate);
             var matchPercent = capturedBirthdate.length > 0 ? Math.round((matchScore / capturedBirthdate.length) * 100) : 0;

            if (__$("btnSelect")) {
                __$("btnSelect").className = "button_orange";
                __$("btnSelect").setAttribute("pos", pos);

                __$("btnSelect").onclick = function () {

                   // showSpinner();

                    window.location = "/patients/" + JSON.parse(sortedPeople[parseInt(this.getAttribute('pos'))])['patient_id'];
                }
            }

            if (__$("btnUpdate")) {


                if (obj["_id"] != null) {

                    __$("btnUpdate").className = "button_blue";
                    __$("btnUpdate").setAttribute("pos", pos);

                    __$("btnUpdate").onclick = function () {

                     //   showSpinner();

                        var clickedObj = JSON.parse(sortedPeople[parseInt(this.getAttribute("pos"))]);

                        json["national_id"] = clickedObj["_id"];

                        ajaxProcessRequest("update");
                    }

                }
            }

            var rows = [
                [
                    {
                        field: "First Name",
                        value: obj.names.given_name
                    },
                    {
                        field: "Last Name",
                        value: obj.names.family_name
                    }
                ],
                [
                    {
                        field: "Gender",
                        value: obj.gender
                    },
                    {
                        field: "Birthdate",
                        value: highlightBirthdate(capturedBirthdate, (obj.birthdate_estimated ? "~" : "") + obj.birthdate),
                        highlight: true
                    }
                ],
                [
                    {
                        field: "Match Score",
                        value: matchPercent + "%",
                        highlight: matchPercent >= 50
                    },
                    {
                        field: "National ID",
                        value: obj._id
                    }
                ],
                [
                    {
                        field: "Other Identifiers",
                        value: []
                    },
                    {
                        field: "",
                        value: ""
                    }
                ],
                [
                    {
                        field: "Current Address",
                        value: formatAddress(obj.addresses, ["current_residence", "current_village", "current_ta", "current_district"], "<br />"),
                        classes: "no_bottom"
                    },
                    {
                        field: "Home Address",
                        value: formatAddress(obj.addresses, ["home_village", "home_ta", "home_district"], "<br />"),
                        classes: "no_bottom"
                    }
                ]
            ];

            for (var e = 0; e < obj.patient.identifiers.length; e++) {
                rows[3][0]["value"].push(Object.keys(obj.patient.identifiers[e]) + ": " + obj.patient.identifiers[e][Object.keys(obj.patient.identifiers[e])] + "<br />");
            }

            var table = document.createElement("div");
            table.className = "table";
            table.style.width = "100%";
            table.style.borderSpacing = "0px";

            __$("matched").appendChild(table);

            for (var i in rows) {
                var row = document.createElement("div");
                row.className = "row";

                table.appendChild(row);

                var cell1 = document.createElement("div");
                cell1.className = "cell bold label_cell" + (rows[i][0].classes != undefined ? " " + rows[i][0].classes : "");
                cell1.innerHTML = rows[i][0].field;

                row.appendChild(cell1);

                var cell2 = document.createElement("div");
                cell2.className = "cell input_cell" + (rows[i][0].classes != undefined ? " " + rows[i][0].classes : "");
                cell2.innerHTML = rows[i][0].value;

                row.appendChild(cell2);

                var cell3 = document.createElement("div");
                cell3.className = "cell";
                cell3.innerHTML = "&nbsp;";

                row.appendChild(cell3);

                var cell4 = document.createElement("div");
                cell4.className = "cell bold label_cell" + (rows[i][1].classes != undefined ? " " + rows[i][1].classes : "");
                cell4.innerHTML = rows[i][1].field;

                row.appendChild(cell4);

                var cell5 = document.createElement("div");
                cell5.className = "cell input_cell" + (rows[i][1].classes != undefined ? " " + rows[i][1].classes : "") + (rows[i][1].highlight ? " highlighted" : "");
                cell5.innerHTML = rows[i][1].value;

                row.appendChild(cell5);
            }
        }
    }

    <% if has_results %>
    ajaxRequest(1);
    <% end %>
    //-->
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var snackbar = document.getElementById("snackbar");
      if (snackbar && snackbar.textContent.trim() !== "") {
        snackbar.classList.add("show");
        setTimeout(function () {
          snackbar.classList.remove("show");
        }, 3000);
      }
    });
  </script>
</body>
</html>
