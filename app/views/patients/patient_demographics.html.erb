<% patient = @person.patient %>
<% name = @person.names.first %>
<% current_address = @person.addresses.last %>
<% dob_text = begin
  day = (@person.birthdate_estimated.to_s == '1' ? '?' : (@person.birthdate.to_date.strftime('%d') rescue '?'))
  month = ((@person.birthdate_estimated.to_s == '1' and (@person.birthdate.to_date.strftime('%d') rescue '0').to_s.strip == '10') ? '?' : (@person.birthdate.to_date.strftime('%b') rescue '?'))
  year = (@person.birthdate.to_date.strftime('%Y') rescue '?')
  "#{day}/#{month}/#{year}"
rescue
  ''
end %>
<% gender_text = (@person.gender.to_s.downcase == 'm' ? 'Male' : (@person.gender.to_s.downcase == 'f' ? 'Female' : '')) %>
<%
  session_user = current_user
  session_location = current_location
  session_role_record = session_user&.user_roles&.first
  session_role_value = session_role_record&.role
  session_role_name = if session_role_value.respond_to?(:name)
                        session_role_value.name
                      else
                        session_role_value.to_s
                      end
%>

<style type="text/css">
  :root {
    --font-base: "Century Gothic", "Trebuchet MS", Arial, sans-serif;
    --fs-title: 20px;
    --fs-meta: 14px;
    --fs-banner-name: 30px;
    --fs-banner-sub: 16px;
    --fs-section: 18px;
    --fs-label: 14px;
    --fs-value: 16px;
    --fs-button: 14px;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: #d7d7d9;
    font-family: var(--font-base);
    font-size: 16px;
    line-height: 1.35;
    color: #0f1524;
  }

  .confirm-shell {
    min-height: 100vh;
    border: 1px solid var(--ui-color-border);
    box-sizing: border-box;
    padding-bottom: 120px;
  }

  .confirm-top {
    display: grid;
    grid-template-columns: 1fr 190px;
    gap: 8px;
    padding: 12px;
    border-bottom: 2px solid var(--ui-color-border);
  }

  .confirm-top-main {
    border: 2px solid var(--ui-color-border);
    background: #f5f5f6;
    padding: 12px 18px;
  }

  .confirm-top-title {
    font-size: var(--fs-title);
    color: #1c2869;
    font-weight: 700;
    margin-bottom: 8px;
    line-height: 1.25;
    letter-spacing: 0.2px;
  }

  .confirm-meta {
    font-size: var(--fs-meta);
    color: #22324a;
    line-height: 1.75;
    display: grid;
    grid-template-columns: 100px 1fr 60px 1fr;
    column-gap: 12px;
    row-gap: 4px;
  }

  .confirm-meta > div:nth-child(odd) {
    font-weight: 700;
    color: #2b3d5e;
  }

  .confirm-meta > div:nth-child(even) {
    font-weight: 600;
    color: #101828;
  }

  .confirm-brand {
    border: 2px solid var(--ui-color-border);
    background: #f5f5f6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #0f1524;
  }

  .confirm-brand strong {
    font-size: 1.5em;
    color: #0f1524;
    margin: 0;
  }
  .confirm-brand span {
    margin: 6px 0 0;
    font-size: 1.05em;
    color: #2f3f58;
  }

  .confirm-body {
    padding: 16px 20px;
  }

  .patient-banner {
    background: linear-gradient(#4e67bb, #3b53a9);
    color: #fff;
    border: 2px solid var(--ui-color-border);
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .patient-name {
    font-size: var(--fs-banner-name);
    font-weight: 700;
    line-height: 1.1;
  }

  .patient-sub {
    margin-top: 8px;
    font-size: var(--fs-banner-sub);
    color: #dde4ff;
  }

  .details-card {
    border: 2px solid var(--ui-color-border);
    background: #efeff0;
    padding: 30px 34px;
    margin-bottom: 26px;
  }

  .section-title {
    font-size: var(--fs-section);
    font-weight: 700;
    color: #111;
    margin: 4px 0 18px;
    border-bottom: 2px solid var(--ui-color-border);
    padding-bottom: 12px;
  }

  .rows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .row {
    border-bottom: 1px solid #c9ccd3;
    padding: 18px 0;
    display: grid;
    grid-template-columns: 170px 1fr;
    align-items: center;
    gap: 16px;
  }

  .label {
    color: #3f4f6e;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.2px;
  }

  .value {
    color: #0f1524;
    font-size: var(--fs-value);
    font-weight: 600;
  }

  .confirm-actions {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(#343438, #202024);
    border-top: 1px solid #3f4046;
    padding: 12px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn {
    border: 1px solid #243071;
    border-radius: 4px;
    color: #fff;
    font-weight: 700;
    padding: 12px 24px;
    font-size: var(--fs-button);
    background: linear-gradient(#5e78d1, #30489c);
    text-decoration: none;
    display: inline-block;
  }

  .btn.cancel {
    border-color: #6f0808;
    background: linear-gradient(#df2642, #ad0018);
  }

  .btn.warning {
    border-color: #7c5800;
    background: linear-gradient(#dfb14a, #b27a00);
  }

  .btn.success {
    border-color: #0b6f2f;
    background: linear-gradient(#29b45f, #04853c);
  }

  .right-actions { display: flex; gap: 8px; }

  @media (max-width: 1100px) {
    :root {
      --fs-title: 18px;
      --fs-meta: 14px;
      --fs-banner-name: 26px;
      --fs-banner-sub: 15px;
      --fs-section: 17px;
      --fs-label: 14px;
      --fs-value: 15px;
      --fs-button: 14px;
    }
    .confirm-top {
      grid-template-columns: 1fr;
    }
    .confirm-brand {
      min-height: 110px;
    }
    .rows {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 160px 1fr;
    }
  }

  @media (max-width: 700px) {
    :root {
      --fs-title: 19px;
      --fs-meta: 14px;
      --fs-banner-name: 24px;
      --fs-banner-sub: 15px;
      --fs-section: 18px;
      --fs-label: 13px;
      --fs-value: 15px;
      --fs-button: 14px;
    }
    .confirm-shell {
      padding-bottom: 138px;
    }
    .confirm-body {
      padding: 12px;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 10px 0;
    }
    .label, .value {
      line-height: 1.25;
    }
    .confirm-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    .right-actions {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .btn {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
  
</style>

<div class="confirm-shell">
  <div class="confirm-top">
    <div class="confirm-top-main">
      <div class="confirm-top-title">Confirm Patient Details</div>
      <div class="confirm-meta">
        <div>User</div><div><%= session_user&.name.presence || '-' %></div>
        <div>Location</div><div><%= session_location&.name.presence || '-' %></div>
        <div>Role</div><div><%= session_role_name.presence || '-' %></div>
      </div>
    </div>
    <div class="confirm-brand">
      <strong>eBilling</strong>
      <span><%= Date.today.strftime('%d %b %Y') %></span>
    </div>
  </div>

  <div class="confirm-body">
    <div class="patient-banner">
      <div>
        <div class="patient-name"><%= [name&.family_name, name&.given_name].compact.join(', ') %></div>
        <div class="patient-sub">
          Patient ID: <%= patient&.national_id || '-' %>
        </div>
      </div>
    </div>

    <div class="details-card">
      <div class="section-title">Patient Demographics</div>
      <div class="rows">
        <div>
          <div class="row">
            <div class="label">First Name</div>
            <div class="value"><%= name&.given_name || '' %></div>
          </div>
          <div class="row">
            <div class="label">Date of Birth</div>
            <div class="value"><%= dob_text %></div>
          </div>
          <div class="row">
            <div class="label">Home District</div>
            <div class="value"><%= current_address&.address2 || '' %></div>
          </div>
          <div class="row">
            <div class="label">Home Village</div>
            <div class="value"><%= current_address&.city_village || '' %></div>
          </div>
        </div>

        <div>
          <div class="row">
            <div class="label">Last Name</div>
            <div class="value"><%= name&.family_name || '' %></div>
          </div>
          <div class="row">
            <div class="label">Gender</div>
            <div class="value"><%= gender_text %></div>
          </div>
          <div class="row">
            <div class="label">Home T/A</div>
            <div class="value"><%= current_address&.county_district || '' %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="confirm-actions">
    <a class="btn cancel" href="/">Cancel</a>
    <div class="right-actions">
      <a class="btn warning" href="/patients/<%= patient.patient_id %>/edit?field=address2">Update Location</a>
      <% source_value = params[:source].to_s %>
      <% safe_source = %w[manual scan].include?(source_value) ? source_value : "" %>
      <a class="btn success" href="/patients/<%= patient.id %>/confirm_and_proceed?source=<%= safe_source %>">Confirm & Proceed</a>
    </div>
  </div>
</div>
