<script type="text/javascript">
    tt_cancel_destination = "/services"
</script>

<%= form_for :service, :method => "PATCH" ,:url => service_path  do |f| %>

    <%= text_field_tag "service[name]", @service.name,
                       {:helptext => "Enter name of new service"}  %>

    <%= select_tag "service[category]", category_options,
                   {:helptext => "Select service category",
                    :doublepane => 'false'} %>

    <%= text_field_tag "service_price[general][price]", nil,
                       {:field_type => "number",
                        :tt_pageStyleClass => "NumbersOnly",
                        :helptext => "Enter general price for new service"}  %>

    <%= text_field_tag "service_price[private][price]", nil,
                       {:field_type => "number",
                        :tt_pageStyleClass => "NumbersOnly",
                        :helptext => "Enter private price for new service"}  %>

    <div class="service-demographic-heading">Service for</div>
    <div class="service-demographic-flags">
      <% demo_value = @service.service_sets.pluck(:name).sort == ['under_5', 'male', 'female'] ? 'all' : (@service.service_sets.pluck(:name).sort == ['male', 'female'] ? 'male_female' : (@service.service_sets.pluck(:name).sort == ['male'] ? 'male' : (@service.service_sets.pluck(:name).sort == ['female'] ? 'female' : (@service.service_sets.pluck(:name).sort == ['under_5'] ? 'child' : '')))) %>
      <%= radio_button_tag "service[demographics]", "child", demo_value == 'child' %> <label for="service_demographics_child">Under 5</label><br/>
      <%= radio_button_tag "service[demographics]", "male", demo_value == 'male' %> <label for="service_demographics_male">Male</label><br/>
      <%= radio_button_tag "service[demographics]", "female", demo_value == 'female' %> <label for="service_demographics_female">Female</label><br/>
      <%= radio_button_tag "service[demographics]", "male_female", demo_value == 'male_female' %> <label for="service_demographics_male_female">Male &amp; Female</label><br/>
      <%= radio_button_tag "service[demographics]", "all", demo_value == 'all' %> <label for="service_demographics_all">All (Under 5, Male, Female)</label>
    </div>

    <%= hidden_field_tag "creator", current_user.id %>

<% end %>
