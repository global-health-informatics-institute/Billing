<%= form_for @user, method: 'PATCH', url: user_path(@user) do |f| %>
  <table width='100%' cellpadding=10 cellspacing=0>
    <% if @field == 'NAME' %>
      <tr>
        <td>
          First Name
        </td>
        <td>
          <%= text_field_tag :given_name, @user.first_name, helpText: 'First Name', ajaxURL: '/patients/given_names?search_string=', allowFreeText: true %>
        </td>
      </tr>
      <tr>
        <td>
          Family Name
        </td>
        <td>
          <%= text_field_tag :family_name, @user.last_name, helpText: 'Family Name', ajaxURL: '/patients/family_names?search_string=', allowFreeText: true %>
        </td>
      </tr>
    <% end %>

    <!-- Display username field if the current field is 'USERNAME' -->
    <% if @field == 'USERNAME' || @field == 'NAME' %>
      <tr>
        <td>
          Username
        </td>
        <td>
          <%= text_field_tag :username, @user.username, helpText: 'Username' %>
        </td>
      </tr>
    <% end %>

    <!-- Add password field for validation -->
    <tr>
      <td>
        Enter Password
      </td>
      <td>
        <%= password_field_tag :password, nil, helpText: 'Enter your current password to proceed' %>
      </td>
    </tr>

    <%= hidden_field_tag 'user_id', @user.id %>
    <%= hidden_field_tag 'fields', @field %>
    <%= submit_tag 'Update', class: 'btn' %>
  </table>
<% end %>