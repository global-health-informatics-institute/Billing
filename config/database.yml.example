
default: &default
  adapter: mysql2
  username: <%= ENV["DATABASE_USERNAME"] %>
  password: <%= ENV["DATABASE_PASSWORD"] %>
  host: <%= ENV["DATABASE_HOST"] %>
  pool: 5000

development:
  <<: *default
  database: <%= ENV["DATABASE_DATABASE"] %>

# Warning: The database defined as "test" will be erased and
# re-generated from your development database when you run "rake".
# Do not set this db to the same as development or production.
test:
  <<: *default
  database: <%= ENV["TEST_DATABASE_DATABASE"] %>

billing_development:
  <<: *default
  username: <%= ENV["BILLING_DEVELOPMENT_USERNAME"] %>
  password: <%= ENV["BILLING_DEVELOPMENT_PASSWORD"] %>
  database: <%= ENV["BILLING_DEVELOPMENT_DATABASE"] %>

production:
  <<: *default
  database: <%= ENV["PRODUCTION_DATABASE_DATABASE"] %>

registration:
  adapter: mysql2
  username: <%= ENV["REGISTRATION_USERNAME"] %>
  password: <%= ENV["REGISTRATION_PASSWORD"] %>
  database: <%= ENV["REGISTRATION_DATABASE"] %>
  host: <%= ENV["REGISTRATION_HOST"] %>
  pool: 5000